# Copiá este archivo a .env y completá los valores. NUNCA commitees el .env.

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/aoe2overlay
# disable | require | no-verify (no-verify acepta certificados autofirmados)
DATABASE_SSL=disable

# Secreto de Better Auth: mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL pública de esta API
BETTER_AUTH_URL=http://localhost:3001

# Orígenes permitidos (la web), separados por coma
CORS_ORIGINS=http://localhost:3000

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Producción: dominio padre compartido por la web y la API (ej. aoe2overlay.com).
# Vacío en desarrollo local.
COOKIE_DOMAIN=
